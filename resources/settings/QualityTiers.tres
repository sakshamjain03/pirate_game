[gd_resource type="Resource" script_class="QualityTierTable" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/managers/QualityTierTable.gd" id="1_table"]
[ext_resource type="Script" path="res://scripts/managers/QualityTierData.gd" id="1_data"]

[sub_resource type="Resource" id="LowTier"]
script = ExtResource("1_data")
shadow_enabled = false
shadow_distance = 50.0
ssao_enabled = false
glow_enabled = false
ocean_sparkle_enabled = false

[sub_resource type="Resource" id="MediumTier"]
script = ExtResource("1_data")

[sub_resource type="Resource" id="HighTier"]
script = ExtResource("1_data")
shadow_distance = 150.0
msaa_mode = 1

[resource]
script = ExtResource("1_table")
tiers = [SubResource("LowTier"), SubResource("MediumTier"), SubResource("HighTier")]
