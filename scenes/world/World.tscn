[node name="Ocean" parent="." instance=ExtResource("2_ocean")]

; Port Royal now sits at the origin, so the player spawns 40u south of it in open
; water rather than inside the island's collision cylinder. Position scaled
; x2.5 for the M10 Expanded layout (docs/11_WORLD_MAP.md §4b) along with
; every island below; the 13.7u terrain union radius is a fixed physical
; prop size and does not scale, so clearance only improves at this distance.
[node name="PlayerShip" parent="." instance=ExtResource("3_ship")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.3, 100)

[node name="Enemies" type="Node3D" parent="."]

; The three authored enemies are re-seated into the Beginner ring (212.5-237.5u
; from home in the Expanded layout, x2.5 of the original Compact 85-95u),
; each clear of every island by an even wider margin than Compact (uniform
; scaling only increases separation). Rotations are unchanged.
[node name="EnemyShip1" parent="Enemies" instance=ExtResource("13_enemy_ship")]
transform = Transform3D(0.866025, 0, 0.5, 0, 1, 0, -0.5, 0, 0.866025, 212.5, 0.3, 75)

[node name="EnemyShip2" parent="Enemies" instance=ExtResource("13_enemy_ship")]
transform = Transform3D(-0.5, 0, 0.866025, 0, 1, 0, -0.866025, 0, -0.5, -100, 0.3, -187.5)

[node name="EnemyShip3" parent="Enemies" instance=ExtResource("13_enemy_ship")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 25, 0.3, 237.5)

