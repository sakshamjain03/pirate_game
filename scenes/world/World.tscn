[node name="Islands" type="Node3D" parent="."]

; Island layout follows the "Expanded" ring bands in docs/11_WORLD_MAP.md §4b
; (M10 — all Compact coordinates x2.5): home at the origin, Beginner
; 150-275u, Contested 350-450u, Imperial 550-675u. Distance from home is the
; game's primary danger signal, so region tier and distance must agree — the
; Compact layout's D59 fix (tier ordering must hold) carries forward exactly
; under uniform scaling. Every pair remains well clear of the 13.7u terrain
; union radius (a fixed physical prop size, unaffected by this scale change)
; plus navigation room on both hulls. These transforms are also the values
; Island.gd::_ready() now writes back from IslandData.world_position at
; runtime (M10 Requirement 2) — kept in sync here for accurate editor preview.
[node name="Island" parent="Islands" instance=ExtResource("5_isl")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0)
island_data = ExtResource("16_port_royal")

[node name="Island2" parent="Islands" instance=ExtResource("5_isl")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -175, 0, 137.5)
island_data = ExtResource("17_tortuga")

[node name="Island3" parent="Islands" instance=ExtResource("5_isl")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 100, 0, -375)
island_data = ExtResource("18_skull_cove")

