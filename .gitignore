# Godot-specific ignores
.godot/
*.translation
export_presets.cfg
*.import

# Godot editor/engine binaries (installed separately, not vendored in-repo)
Godot_v*.exe

# Addon .uid sidecars are regenerated by the editor on every import
addons/**/*.uid

# Claude Code local session/tooling directory
.claude/

# Local credentials (never committed) — see .env for M15 Supabase/auth setup instructions
.env

# Vendored third-party asset kit (not tracked in-repo)
/assets_kit/

# OS generated files
.DS_Store
Thumbs.db

# Ad-hoc debug/test output
*.log
/screenshot_*.png
/final_*
/tree.txt

# Debug screenshot captures (scenes/debug/CaptureHarness.tscn)
.capture*/

# Android signing keystores — never committed (M13 Requirement 2.3)
*.jks
*.keystore

# Android Gradle build template — regenerable from the official export templates
# (godot_v4.3-stable android_source.zip), not hand-customized, same rationale as
# the gitignored engine binary and export templates themselves (M13)
/android/build/

# Local Android export output
/builds/
