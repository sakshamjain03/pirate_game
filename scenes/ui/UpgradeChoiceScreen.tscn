[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/UpgradeChoiceScreen.gd" id="1_upgrade"]

; Deliberately a bare shell. The offer size varies per encounter (2-4 normally,
; more for a boss, per docs/navalCombat.md §12), so the cards are built in code —
; the same convention IslandMenu already follows for variable content.
[node name="UpgradeChoiceScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_upgrade")
