description = "Board the Intransigent instead of sinking her"
condition = 4
target_id = "intransigent"
target_count = 1
is_optional = true

[sub_resource type="Resource" id="Close_1"]
script = ExtResource("3_beat")
speaker_id = "vance"
speaker_name = "Admiral Sir Edmund Vance"
text = "Well. That is that, and I find I mind less than I expected to."
mood = 0

[sub_resource type="Resource" id="Close_2"]
script = ExtResource("3_beat")
speaker_id = "vance"
speaker_name = "Admiral Sir Edmund Vance"
text = "You should know what you have actually won. I was the fence, not the wolf. In six weeks the Spanish treasure fleet crosses this water — a hundred and twenty thousand in silver behind Beatriz de Cárdenas, who has never lost a crossing and does not care whose flag is on your harbour."
mood = 0

[sub_resource type="Resource" id="Close_3"]
script = ExtResource("3_beat")
speaker_id = "vance"
speaker_name = "Admiral Sir Edmund Vance"
text = "I was trying to keep this water boring, Captain. You have made it interesting. I hope you enjoy that."
mood = 4

[resource]
script = ExtResource("1_chapter")
chapter_id = "ch4_the_admirals_gambit"
chapter_number = 4
title = "The Admiral's Gambit"
log_summary = "Followed Admiral Vance to Frostbite Reef and sank HMS Intransigent — the first real boss, and the first true loss for the Crown."
required_previous_chapter = "ch3_the_kings_answer"
opening_beats = Array[DialogueBeatData]([SubResource("Open_1"), SubResource("Open_2"), SubResource("Open_3")])
objectives = Array[ObjectiveData]([SubResource("Obj_4_1"), SubResource("Obj_4_2"), SubResource("Obj_4_3"), SubResource("Obj_4_4"), SubResource("Obj_4_5"), SubResource("Obj_4_6"), SubResource("Obj_4_7"), SubResource("Obj_4_8")])
closing_beats = Array[DialogueBeatData]([SubResource("Close_1"), SubResource("Close_2"), SubResource("Close_3")])
reward_gold = 3000
