[sub_resource type="BoxShape3D" id="BoxShape3D_hull"]
size = Vector3(3.0, 2.0, 8.0)

; center_of_mass is set explicitly (and below the float points at y=0) because
; the auto-computed one sits at the collision shape's centre, y=+1.0. With
; buoyancy applied at the float points a metre BELOW the centre of mass, the
; hull is an inverted pendulum: any small tilt generates more tilting torque,
; so ships heeled over and capsized no matter how strong the restoring torque
; was. Ballasting the mass below the buoyancy points is what makes a hull
; self-righting, in the sim exactly as in reality.
