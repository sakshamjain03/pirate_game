closing_beats = Array[DialogueBeatData]([SubResource("Close_1"), SubResource("Close_2"), SubResource("Close_3")])
lessons = Array[LessonData]([ExtResource("L_Ch3_Heat"), ExtResource("L_Ch3_LieLow"), ExtResource("L_Ch3_Defence"), ExtResource("L_Ch3_Fleet"), ExtResource("L_Ch3_Eights")])
