; Matches the Kenney hull footprint (x = -2.40..2.40, and ~9 long in Z for the
; small/medium classes). The previous 3.0-wide box was narrower than the hull
; it wrapped, so ships visually overlapped when they collided.
[sub_resource type="BoxShape3D" id="BoxShape3D_hull"]
size = Vector3(4.6, 2.0, 9.0)

; center_of_mass is set explicitly (and below the float points at y=0) because
; the auto-computed one sits at the collision shape's centre, y=+1.0. With
; buoyancy applied at the float points a metre BELOW the centre of mass, the
; hull is an inverted pendulum: any small tilt generates more tilting torque,
; so ships heeled over and capsized no matter how strong the restoring torque
; was. Ballasting the mass below the buoyancy points is what makes a hull
; self-righting, in the sim exactly as in reality.
[node name="PlayerShip" type="RigidBody3D" groups=["player_ship"]]
collision_layer = 1
collision_mask = 7
center_of_mass_mode = 1
center_of_mass = Vector3(0, -0.6, 0)
can_sleep = false
script = ExtResource("1_ship")
ship_stats = ExtResource("5_stats")
active_captain = ExtResource("11_jack")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.0, 0)
shape = SubResource("BoxShape3D_hull")

; The Kenney ship GLBs already contain their own sails and flags as child
; nodes. The separate PirateFlag/MastRopes props that used to hang here were
; authored for a much smaller, long-gone hull: they sat at y=3.5 on a model
; whose masts reach y=9.96, so they floated in mid-air beside the rigging and
; read as loose scattered debris rather than parts of a ship.
[node name="ShipModel" type="Node3D" parent="."]
transform = Transform3D(-1, 0, -8.74228e-08, 0, 1, 0, 8.74228e-08, 0, -1, 0, 0, 0)
script = ExtResource("4_vis")

[node name="ShipMovement" type="Node" parent="."]
script = ExtResource("2_mov")
ship_stats = ExtResource("5_stats")

[node name="BuoyancySimulator" type="Node" parent="."]
script = ExtResource("3_buoy")
ship_stats = ExtResource("5_stats")

[node name="ShipDamage" type="Node" parent="."]
script = ExtResource("12_damage")
ship_stats = ExtResource("5_stats")

[node name="CombatModifiers" type="Node" parent="."]
script = ExtResource("21_mods")

[node name="CaptainAbility" type="Node" parent="."]
script = ExtResource("22_ability")

[node name="FiringSolver" type="Node" parent="."]
script = ExtResource("20_solver")
ship_stats = ExtResource("5_stats")

[node name="ShipCombat" type="Node" parent="."]
script = ExtResource("10_combat")
ship_stats = ExtResource("5_stats")

; Float points widened from x=+/-1.5 to +/-1.9 to sit under the real hull
; (x = -2.40..2.40). A wider buoyancy base gives a longer righting lever arm,
; which strengthens roll recovery rather than weakening it. Kept inboard of
; the hull edge so a heeled ship still lifts a point clear of the water.
[node name="FloatPoints" type="Node3D" parent="."]

[node name="FrontLeft" type="Marker3D" parent="FloatPoints"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.9, 0.0, -3.8)

[node name="FrontRight" type="Marker3D" parent="FloatPoints"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.9, 0.0, -3.8)

[node name="BackLeft" type="Marker3D" parent="FloatPoints"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.9, 0.0, 4.0)

[node name="BackRight" type="Marker3D" parent="FloatPoints"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.9, 0.0, 4.0)

; Cannon markers sit just outside the hull sides. The Kenney ship models span
; x = -2.40..2.40 with the deck around y = 1.0..2.0, so the previous x=+/-2.0
; put every cannon INSIDE the hull, poking through the planking. x=+/-2.5
; clears the bulwark; the Z spread matches the ~9-unit hull length rather than
; the 4-unit one these markers were originally authored against.
[node name="PortMarker1" type="Marker3D" parent="."]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, -2.05, 1.7, -2.4)

[node name="PortMarker2" type="Marker3D" parent="."]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, -2.05, 1.7, 0)

[node name="PortMarker3" type="Marker3D" parent="."]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, -2.05, 1.7, 2.4)

[node name="StarboardMarker1" type="Marker3D" parent="."]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, 2.05, 1.7, -2.4)

[node name="StarboardMarker2" type="Marker3D" parent="."]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, 2.05, 1.7, 0)

[node name="StarboardMarker3" type="Marker3D" parent="."]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, 2.05, 1.7, 2.4)

; Chaser mounts (docs/navalCombat.md §3: bow/stern weapon slots). Present on
; every hull since ship_stats — not the scene — swap when the player changes
; hulls; ShipCombat/FiringSolver only activate a mount when the currently
; equipped ShipStats authors has_bow_chaser/has_stern_chaser.
[node name="BowMarker" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.7, -4.3)

[node name="SternMarker" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.7, 4.3)

[node name="WakeSpawnPoint" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.2, 4.5)
