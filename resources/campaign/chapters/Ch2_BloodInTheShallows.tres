[gd_resource type="Resource" script_class="ChapterData" load_steps=16 format=3]

[ext_resource type="Script" path="res://scripts/world/ChapterData.gd" id="1_chapter"]
[ext_resource type="Script" path="res://scripts/world/ObjectiveData.gd" id="2_objective"]
[ext_resource type="Script" path="res://scripts/world/DialogueBeatData.gd" id="3_beat"]

[sub_resource type="Resource" id="Open_1"]
script = ExtResource("3_beat")
speaker_id = "morrows_messenger"
speaker_name = "Morrow's Messenger"
text = "Compliments of Blackjaw Morrow, out of Skull Cove. He's pleased for you, truly. New port, new flag, all very stirring."
mood = 0

[sub_resource type="Resource" id="Open_2"]
script = ExtResource("3_beat")
speaker_id = "morrows_messenger"
speaker_name = "Morrow's Messenger"
text = "The shallows run on a tithe. One part in five, collected quarterly, and in exchange nobody burns your distillery. Blackjaw kept this water free of the King's men for twenty years by making sure no single outfit ever got fat enough to be worth the King's attention."
mood = 3

[sub_resource type="Resource" id="Open_3"]
script = ExtResource("3_beat")
speaker_id = "morrows_messenger"
speaker_name = "Morrow's Messenger"
text = "He'll have your answer now, and he's sent three sloops to carry it."
mood = 3

[sub_resource type="Resource" id="Obj_2_1"]
script = ExtResource("2_objective")
objective_id = "2.1"
description = "Refuse the tithe"
condition = 3
target_id = "pirate_clans"
target_count = 3

[sub_resource type="Resource" id="Obj_2_2"]
script = ExtResource("2_objective")
objective_id = "2.2"
description = "Build a shipyard"
condition = 0
target_id = "shipyard_l1"
target_count = 1

[sub_resource type="Resource" id="Obj_2_3"]
script = ExtResource("2_objective")
objective_id = "2.3"
description = "Buy a hull that can take a hit"
condition = 10
target_count = 1
target_value = 2.0
hint_text = "A class-2 hull (Schooner or Corvette) — trade income and boarding loot will cover it."

[sub_resource type="Resource" id="Obj_2_4"]
script = ExtResource("2_objective")
