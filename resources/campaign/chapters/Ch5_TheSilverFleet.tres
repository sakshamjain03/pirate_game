[sub_resource type="Resource" id="Close_1"]
script = ExtResource("3_beat")
speaker_id = "cardenas"
speaker_name = "Almirante Beatriz de Cárdenas"
text = "You imagine you have taken something from Spain. You have taken one crossing. There will be another in the spring, and I will be commanding it."
mood = 0

[sub_resource type="Resource" id="Close_2"]
script = ExtResource("3_beat")
speaker_id = "cardenas"
speaker_name = "Almirante Beatriz de Cárdenas"
text = "Enjoy your harbour, Captain. It is a very small piece of a very large ocean."
mood = 0

[sub_resource type="Resource" id="Close_3"]
script = ExtResource("3_beat")
speaker_id = "higgins"
speaker_name = "Quartermaster Higgins"
text = "Captain. There's a chart in here that shouldn't be. There's an island on it that isn't on anything else I've ever seen — and I know this hand. This is Solomon Vane's hand, and Vane went down with the Wandering Widow forty years back."
mood = 3

[sub_resource type="Resource" id="Close_4"]
script = ExtResource("3_beat")
speaker_id = "higgins"
speaker_name = "Quartermaster Higgins"
text = "…I'd very much like you to tell me I'm wrong."
mood = 3

[resource]
script = ExtResource("1_chapter")
chapter_id = "ch5_the_silver_fleet"
chapter_number = 5
title = "The Silver Fleet"
log_summary = "Cut Cárdenas' supply, broke her escort, and took Cartagena — the v1 finale, and a chart that shouldn't exist."
required_region_id = "imperial_waters"
opening_beats = Array[DialogueBeatData]([SubResource("Open_1"), SubResource("Open_2"), SubResource("Open_3")])
objectives = Array[ObjectiveData]([SubResource("Obj_5_1"), SubResource("Obj_5_2"), SubResource("Obj_5_3"), SubResource("Obj_5_4"), SubResource("Obj_5_5"), SubResource("Obj_5_6"), SubResource("Obj_5_7"), SubResource("Obj_5_8")])
closing_beats = Array[DialogueBeatData]([SubResource("Close_1"), SubResource("Close_2"), SubResource("Close_3"), SubResource("Close_4")])
reward_gold = 6000
