[sub_resource type="Resource" id="Close_1"]
script = ExtResource("3_beat")
speaker_id = "hale"
speaker_name = "Factor Cornelius Hale"
portrait_path = "res://assets/portraits/Hale.png"
text = "Good afternoon. Cornelius Hale, Merchant Guild. I represent every cargo that passes this water, which until last month included nothing at all bound for here."
mood = 0

[sub_resource type="Resource" id="Close_2"]
script = ExtResource("3_beat")
speaker_id = "hale"
speaker_name = "Factor Cornelius Hale"
portrait_path = "res://assets/portraits/Hale.png"
text = "There is smoke coming from a harbour that has been dead for four years. My ledger requires a name for it. Whom, precisely, am I invoicing?"
mood = 0

[sub_resource type="Resource" id="Close_3"]
script = ExtResource("3_beat")
speaker_id = "hale"
speaker_name = "Factor Cornelius Hale"
portrait_path = "res://assets/portraits/Hale.png"
text = "One more thing, for your ledger's sake. Spain still calls this whole sea her lake, treaty or no — His Majesty's Navy merely patrols it. You'll want to learn the difference before you're rich enough for either to notice you."
mood = 0

[sub_resource type="Resource" id="Close_4"]
script = ExtResource("3_beat")
speaker_id = "higgins"
speaker_name = "Quartermaster Higgins"
portrait_path = "res://assets/portraits/Higgins.svg"
text = "Hale won't be the last to come calling. Word is Skull Cove takes a cut of anything that floats in these shallows. Keep the guns loaded, Captain."
mood = 4

[resource]
script = ExtResource("1_chapter")
chapter_id = "ch1_the_drowned_port"
chapter_number = 1
title = "The Drowned Port"
log_summary = "Claimed and raised Port Royal from the ruin the Crown and every empire wrote off — a farm, a lumber mill, a warehouse, a tavern, and a captain to your name."
opening_beats = Array[DialogueBeatData]([SubResource("Open_1"), SubResource("Open_2"), SubResource("Open_3"), SubResource("Open_4")])
objectives = Array[ObjectiveData]([SubResource("Obj_1_1"), SubResource("Obj_1_2"), SubResource("Obj_1_3"), SubResource("Obj_1_4"), SubResource("Obj_1_5"), SubResource("Obj_1_6"), SubResource("Obj_1_10"), SubResource("Obj_1_7"), SubResource("Obj_1_8"), SubResource("Obj_1_9")])
closing_beats = Array[DialogueBeatData]([SubResource("Close_1"), SubResource("Close_2"), SubResource("Close_3"), SubResource("Close_4")])
lessons = Array[LessonData]([ExtResource("L_Ch1_Sailing"), ExtResource("L_Ch1_Docking"), ExtResource("L_Ch1_IslandMenu"), ExtResource("L_Ch1_Building"), ExtResource("L_Ch1_Timers"), ExtResource("L_Ch1_Storage"), ExtResource("L_Ch1_ManualFire"), ExtResource("L_Ch1_Ammo"), ExtResource("L_Ch1_Captains")])
reward_gold = 300
reward_eights = 10
