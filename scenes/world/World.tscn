[node name="Islands" type="Node3D" parent="."]

; Island layout follows the "Compact" ring bands in docs/11_WORLD_MAP.md §4a:
; home at the origin, Beginner 60-110u, Contested 140-180u, Imperial 220-270u.
; Distance from home is the game's primary danger signal, so region tier and
; distance must agree — before 2026-08-14 they did not (D59: tier-2 Skull Cove
; sat 54u out while tier-1 Tortuga sat 94u). Every pair is >=40u apart, which
; clears the 13.7u terrain union radius plus navigation room on both hulls.
[node name="Island" parent="Islands" instance=ExtResource("5_isl")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0)
island_data = ExtResource("16_port_royal")

[node name="Island2" parent="Islands" instance=ExtResource("5_isl")]
