[sub_resource type="Resource" id="Close_1"]
script = ExtResource("3_beat")
speaker_id = "marguerite"
portrait_path = "res://assets/portraits/Marguerite.png"
speaker_name = "Marguerite"
text = "They read you the same speech they read me. Mine ended with the harbour on fire and the Admiralty calling it a lawful action."
mood = 2

[sub_resource type="Resource" id="Close_2"]
script = ExtResource("3_beat")
speaker_id = "marguerite"
portrait_path = "res://assets/portraits/Marguerite.png"
speaker_name = "Marguerite"
text = "So I'll ask what nobody else will. Are you building a port, or are you just building something bigger to lose?"
mood = 2

[sub_resource type="Resource" id="Close_3"]
script = ExtResource("3_beat")
speaker_id = "marguerite"
portrait_path = "res://assets/portraits/Marguerite.png"
speaker_name = "Marguerite"
text = "If it's something bigger, build it where the Navy isn't looking. There's a cay off their charts. Pelican Cay. Plot a course and see for yourself."
mood = 2

[resource]
script = ExtResource("1_chapter")
chapter_id = "ch3_the_kings_answer"
chapter_number = 3
title = "The King's Answer"
log_summary = "Broke the Crown's blockade, built Port Royal's defenses, and survived the first raid the Admiralty sent."
