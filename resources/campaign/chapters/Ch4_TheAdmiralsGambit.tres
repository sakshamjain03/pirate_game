[sub_resource type="Resource" id="Open_1"]
script = ExtResource("3_beat")
speaker_id = "vance"
portrait_path = "res://assets/portraits/Vance.png"
speaker_name = "Admiral Sir Edmund Vance"
text = "Commander Hollis followed his orders correctly and lost, which tells me the orders were wrong, not the man."
mood = 0

[sub_resource type="Resource" id="Open_2"]
script = ExtResource("3_beat")
speaker_id = "vance"
portrait_path = "res://assets/portraits/Vance.png"
speaker_name = "Admiral Sir Edmund Vance"
text = "I was at anchor when Port Royal went into the sea. I watched two thousand people drown in a town that had no law in it, and I have spent every year since making certain no other harbour gets the chance."
mood = 2

[sub_resource type="Resource" id="Open_3"]
script = ExtResource("3_beat")
speaker_id = "vance"
portrait_path = "res://assets/portraits/Vance.png"
speaker_name = "Admiral Sir Edmund Vance"
text = "You are not a criminal to me. You are a repetition. Plant your flag on one more harbour and I will come to take it down."
mood = 0

[sub_resource type="Resource" id="Open_4"]
script = ExtResource("3_beat")
speaker_id = "higgins"
speaker_name = "Quartermaster Higgins"
portrait_path = "res://assets/portraits/Higgins.svg"
text = "Find the second cay, hold it through a Navy raid, and turn this water's balance. Plant a fleet captain where they can't reach her, and the Admiral loses both."
mood = 1

