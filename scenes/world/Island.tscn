shape = SubResource("CylinderShape3D_1")

; Terrain/prop heights below sit at y=0.9+ — the water shader's Gerstner
; waves peak at wave_height + wave_height*0.5 (~0.68 at the authored 0.45),
; so anything lower than that was being washed over by every wave cycle.

