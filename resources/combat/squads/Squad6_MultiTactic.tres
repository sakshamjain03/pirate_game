[gd_resource type="Resource" script_class="SquadData" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/combat/SquadSlotData.gd" id="1_slot"]
[ext_resource type="Script" path="res://scripts/combat/SquadTacticData.gd" id="2_tactic"]
[ext_resource type="Script" path="res://scripts/combat/SquadData.gd" id="3_squad"]
[ext_resource type="PackedScene" path="res://scenes/world/EnemyShip.tscn" id="4_enemy"]
[ext_resource type="Resource" path="res://resources/combat/ai_profiles/Raker.tres" id="5_raker"]
[ext_resource type="Resource" path="res://resources/combat/ai_profiles/LongGunner.tres" id="6_longgunner"]
[ext_resource type="Resource" path="res://resources/combat/ai_profiles/RamRunner.tres" id="7_ramrunner"]

[sub_resource type="Resource" script_class="SquadSlotData" id="Slot1"]
script = ExtResource("1_slot")
hull_scene = ExtResource("4_enemy")
ai_profile = ExtResource("5_raker")
count = 1

[sub_resource type="Resource" script_class="SquadSlotData" id="Slot2"]
script = ExtResource("1_slot")
hull_scene = ExtResource("4_enemy")
ai_profile = ExtResource("6_longgunner")
count = 1

[sub_resource type="Resource" script_class="SquadSlotData" id="Slot3"]
script = ExtResource("1_slot")
hull_scene = ExtResource("4_enemy")
ai_profile = ExtResource("7_ramrunner")
count = 1

[sub_resource type="Resource" script_class="SquadTacticData" id="Tactic"]
script = ExtResource("2_tactic")
formation = 0
display_name = "Nemesis Flotilla"
slot_bearings_deg = [135.0, 0.0, -135.0]

[resource]
script = ExtResource("3_squad")
squad_id = "sq_multi_tactic"
display_name = "Multi-Tactic Nemesis"
slots = [SubResource("Slot1"), SubResource("Slot2"), SubResource("Slot3")]
tactic = SubResource("Tactic")
