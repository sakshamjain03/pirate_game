[sub_resource type="Resource" id="Open_1"]
script = ExtResource("3_beat")
speaker_id = "higgins"
speaker_name = "Quartermaster Higgins"
portrait_path = "res://assets/portraits/Higgins.svg"
text = "That's it, then. That's Port Royal. Half of it's under the water and the other half wishes it was."
mood = 0

[sub_resource type="Resource" id="Open_2"]
script = ExtResource("3_beat")
speaker_id = "higgins"
speaker_name = "Quartermaster Higgins"
portrait_path = "res://assets/portraits/Higgins.svg"
text = "Two thousand souls in one afternoon, and the King's men sailed off and called it cursed. So did everyone else, which is the only reason it's ours."
mood = 2

[sub_resource type="Resource" id="Open_3"]
script = ExtResource("3_beat")
speaker_id = "higgins"
speaker_name = "Quartermaster Higgins"
portrait_path = "res://assets/portraits/Higgins.svg"
text = "Say the word and I'll turn us about. …No? Right. Then we'd best start with something that makes rum, because I'm not doing this sober."
mood = 4

[sub_resource type="Resource" id="Open_4"]
script = ExtResource("3_beat")
speaker_id = "higgins"
speaker_name = "Quartermaster Higgins"
portrait_path = "res://assets/portraits/Higgins.svg"
text = "Mind you — 'ours' wants making official, or some committee out of Kingston will argue the point. A hundred in coin plants the flag proper. Cheapest empire you'll ever buy."
mood = 4

[sub_resource type="Resource" id="Obj_1_1"]
script = ExtResource("2_objective")
objective_id = "1.1"
description = "Come alongside the drowned port"
condition = 8
target_id = "port_royal"
target_count = 1

[sub_resource type="Resource" id="Obj_1_2"]
