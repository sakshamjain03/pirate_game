[node name="Ocean" parent="." instance=ExtResource("2_ocean")]

; Port Royal now sits at the origin, so the player spawns 40u south of it in open
; water rather than inside the island's collision cylinder. 40u clears the 13.7u
; terrain union and the dock marker at local x=16.
[node name="PlayerShip" parent="." instance=ExtResource("3_ship")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.3, 40)

[node name="Enemies" type="Node3D" parent="."]

; The three authored enemies are re-seated into the Beginner ring (85-95u from
; home), each >=40u clear of every island. Rotations are unchanged.
[node name="EnemyShip1" parent="Enemies" instance=ExtResource("13_enemy_ship")]
transform = Transform3D(0.866025, 0, 0.5, 0, 1, 0, -0.5, 0, 0.866025, 85, 0.3, 30)

[node name="EnemyShip2" parent="Enemies" instance=ExtResource("13_enemy_ship")]
