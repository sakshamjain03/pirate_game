size = Vector3(4.6, 2.0, 9.0)

; Cárdenas' flagship (docs/13_CAMPAIGN_LEVELS_1-5.md §7) — a dedicated boss
; hull with its own ship_id, for the same reason as IntransigentBoss.tscn:
; CampaignManager.DEFEAT_BOSS (M7 Task 11) identifies a boss by ship_id, and a
; shared/purchasable template would misidentify a player-owned hull of the
; same class as the boss.
