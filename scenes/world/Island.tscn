; collision_layer 17 = layer 1 (world/ships, so ship hulls still collide with
; the island as before) + layer 5 (terrain, which the camera spring arm alone
; masks against). Without layer 5 the island was indistinguishable from the
; player ship, so a spring arm that avoided islands also collided with the
; hull it was attached to and collapsed inside it.
[node name="Island" type="StaticBody3D"]
collision_layer = 17
script = ExtResource("14_isl")

