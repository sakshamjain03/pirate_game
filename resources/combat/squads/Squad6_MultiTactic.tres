; M30 1.7 squad. Hull counts and bearings are placeholders: tune in M31.
; Bearings are signed degrees off the player's bow (+ = starboard).
[sub_resource type="Resource" script_class="SquadSlotData" id="Slot1"]
script = ExtResource("1_slot")
hull_scene = ExtResource("4_enemy")
ai_profile = ExtResource("p_2")
count = 1
ship_stats = ExtResource("s_3")

[sub_resource type="Resource" script_class="SquadSlotData" id="Slot2"]
script = ExtResource("1_slot")
hull_scene = ExtResource("4_enemy")
ai_profile = ExtResource("p_1")
count = 1
ship_stats = ExtResource("s_1")

[sub_resource type="Resource" script_class="SquadSlotData" id="Slot3"]
script = ExtResource("1_slot")
hull_scene = ExtResource("4_enemy")
ai_profile = ExtResource("p_3")
count = 1
ship_stats = ExtResource("s_0")

[sub_resource type="Resource" script_class="SquadSlotData" id="Slot4"]
script = ExtResource("1_slot")
hull_scene = ExtResource("4_enemy")
ai_profile = ExtResource("p_0")
count = 1
ship_stats = ExtResource("s_2")

[sub_resource type="Resource" script_class="SquadTacticData" id="Tactic"]
script = ExtResource("2_tactic")
formation = 3
display_name = "Nemesis Crescent"
slot_bearings_deg = [135.0, 0.0, -135.0, 90.0]

[resource]
script = ExtResource("3_squad")
squad_id = "sq_nemesis_flotilla"
display_name = "Nemesis Flotilla"
slots = [SubResource("Slot1"), SubResource("Slot2"), SubResource("Slot3"), SubResource("Slot4")]
tactic = SubResource("Tactic")
