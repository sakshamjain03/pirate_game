[gd_resource type="Resource" script_class="ChapterData" load_steps=18 format=3]

[ext_resource type="Script" path="res://scripts/world/ChapterData.gd" id="1_chapter"]
[ext_resource type="Script" path="res://scripts/world/ObjectiveData.gd" id="2_objective"]
[ext_resource type="Script" path="res://scripts/world/DialogueBeatData.gd" id="3_beat"]

[sub_resource type="Resource" id="Open_1"]
script = ExtResource("3_beat")
speaker_id = "higgins"
speaker_name = "Quartermaster Higgins"
text = "Six weeks, the Admiral said. It's been five."
mood = 0

[sub_resource type="Resource" id="Open_2"]
script = ExtResource("3_beat")
speaker_id = "higgins"
speaker_name = "Quartermaster Higgins"
text = "Cárdenas stages out of Cartagena and coals at Mount Brimstone — that volcano's the whole reason the crossing works. Cut the mountain and the fleet crosses thirsty."
mood = 0

[sub_resource type="Resource" id="Open_3"]
script = ExtResource("3_beat")
speaker_id = "higgins"
speaker_name = "Quartermaster Higgins"
text = "I've never in my life advised anyone to attack an empire. I'm advising it now. I'd like the record to show I've changed."
mood = 4

[sub_resource type="Resource" id="Obj_5_1"]
script = ExtResource("2_objective")
objective_id = "5.1"
description = "Cut the supply"
condition = 6
target_id = "volcano_island"
target_count = 1

