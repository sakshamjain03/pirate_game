[sub_resource type="Resource" id="Open_1"]
script = ExtResource("3_beat")
speaker_id = "hollis"
portrait_path = "res://assets/portraits/Hollis.png"
speaker_name = "Commander Hollis"
text = "By order of the Admiralty. The settlement at Port Royal is declared an unlawful occupation of Crown ground. Its harbour is closed. Its trade is contraband."
mood = 3

[sub_resource type="Resource" id="Open_2"]
script = ExtResource("3_beat")
speaker_id = "hollis"
portrait_path = "res://assets/portraits/Hollis.png"
speaker_name = "Commander Hollis"
text = "You have no charter, no letters, and no standing. You have a fortnight to disperse."
mood = 3

[sub_resource type="Resource" id="Open_3"]
script = ExtResource("3_beat")
speaker_id = "hollis"
portrait_path = "res://assets/portraits/Hollis.png"
speaker_name = "Commander Hollis"
text = "I am required to read that aloud before we begin. It is read."
mood = 0

