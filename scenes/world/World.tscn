[node name="EnemyShip3" parent="Enemies" instance=ExtResource("13_enemy_ship")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 10, 0.3, 95)

[node name="CameraRig" parent="." instance=ExtResource("4_cam")]
