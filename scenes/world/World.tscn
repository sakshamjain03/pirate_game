; Replaces WorldEventManager, whose whole job was a 5-minute timer that spawned
; the boss. A boss is now just a Boss-kind EncounterData in this pool, and every
; fight gets a start, an objective, an end and a payout.
[node name="EncounterManager" type="Node" parent="Systems"]
script = ExtResource("19_enc_mgr")
encounter_pool = Array[EncounterData]([ExtResource("24_e1"), ExtResource("25_e2"), ExtResource("26_e3"), ExtResource("27_e4"), ExtResource("28_e5"), ExtResource("29_e6"), ExtResource("40_e7"), ExtResource("41_e8")])
upgrade_pool = Array[BattleUpgradeData]([ExtResource("30_u"), ExtResource("31_u"), ExtResource("32_u"), ExtResource("33_u"), ExtResource("34_u"), ExtResource("35_u"), ExtResource("36_u"), ExtResource("37_u"), ExtResource("38_u"), ExtResource("39_u")])

