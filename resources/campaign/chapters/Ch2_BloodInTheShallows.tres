is_optional = true

[sub_resource type="Resource" id="Close_1"]
script = ExtResource("3_beat")
speaker_id = "higgins"
speaker_name = "Quartermaster Higgins"
text = "Blackjaw's flag is off the pole and the cove is ours. I'd enjoy it more if the smoke wasn't visible from the trade lane."
mood = 0

[sub_resource type="Resource" id="Close_2"]
script = ExtResource("3_beat")
speaker_id = "higgins"
speaker_name = "Quartermaster Higgins"
text = "That lane is the King's."
mood = 2

[resource]
script = ExtResource("1_chapter")
chapter_id = "ch2_blood_in_the_shallows"
chapter_number = 2
title = "Blood in the Shallows"
log_summary = "Refused Blackjaw Morrow's tithe and took Skull Cove — notoriety enough to draw the Crown's eye."
required_previous_chapter = "ch1_the_drowned_port"
opening_beats = Array[DialogueBeatData]([SubResource("Open_1"), SubResource("Open_2"), SubResource("Open_3")])
objectives = Array[ObjectiveData]([SubResource("Obj_2_1"), SubResource("Obj_2_2"), SubResource("Obj_2_3"), SubResource("Obj_2_4"), SubResource("Obj_2_5"), SubResource("Obj_2_6"), SubResource("Obj_2_7"), SubResource("Obj_2_8")])
closing_beats = Array[DialogueBeatData]([SubResource("Close_1"), SubResource("Close_2")])
reward_gold = 800
