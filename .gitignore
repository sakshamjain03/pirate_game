# Godot-specific ignores
.godot/
*.translation
export_presets.cfg
*.import

# Godot editor/engine binaries (installed separately, not vendored in-repo)
Godot_v*.exe

# Addon .uid sidecars are regenerated by the editor on every import
addons/**/*.uid

# Claude Code local session/tooling directory
.claude/

# Vendored third-party asset kit (not tracked in-repo)
/assets_kit/

# OS generated files
.DS_Store
Thumbs.db

# Ad-hoc debug/test output
*.log
/screenshot_*.png
/final_*
/tree.txt

# Debug screenshot captures (scenes/debug/CaptureHarness.tscn)
.capture*/
