[sub_resource type="Resource" id="Close_1"]
script = ExtResource("3_beat")
speaker_id = "hale"
speaker_name = "Factor Cornelius Hale"
text = "Good afternoon. Cornelius Hale, Merchant Guild. I represent every cargo that passes this water, which until last month included nothing at all bound for here."
mood = 0

[sub_resource type="Resource" id="Close_2"]
script = ExtResource("3_beat")
speaker_id = "hale"
speaker_name = "Factor Cornelius Hale"
text = "There is smoke coming from a harbour that has been dead for four years. My ledger requires a name for it. Whom, precisely, am I invoicing?"
mood = 0

[resource]
script = ExtResource("1_chapter")
chapter_id = "ch1_the_drowned_port"
chapter_number = 1
title = "The Drowned Port"
log_summary = "Raised Port Royal from the ruin the Crown and every empire wrote off — a farm, a lumber mill, a warehouse, a tavern, and a captain to your name."
opening_beats = Array[DialogueBeatData]([SubResource("Open_1"), SubResource("Open_2"), SubResource("Open_3")])
objectives = Array[ObjectiveData]([SubResource("Obj_1_1"), SubResource("Obj_1_2"), SubResource("Obj_1_3"), SubResource("Obj_1_4"), SubResource("Obj_1_5"), SubResource("Obj_1_6"), SubResource("Obj_1_7"), SubResource("Obj_1_8")])
closing_beats = Array[DialogueBeatData]([SubResource("Close_1"), SubResource("Close_2")])
reward_gold = 300
